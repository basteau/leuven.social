{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["node:*", "node:*/**", "bun:*", "bun"],
            "message": "Keep code runtime-portable: use web APIs or @portable/* (see docs/CODE.md)."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Bun",
        "message": "Bun APIs belong in scripts/ only (see docs/CODE.md)."
      },
      {
        "name": "process",
        "message": "Use import.meta.env in src/ (see docs/CODE.md)."
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-default-export": "error",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": ["application"],
        "tags": []
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**", "bun:*", "bun"],
                "message": "Keep code runtime-portable: use web APIs or @portable/* (see docs/CODE.md)."
              },
              {
                "group": [
                  "three",
                  "three/*",
                  "react",
                  "react-dom",
                  "react-dom/*",
                  "**/scene/**",
                  "**/app/**"
                ],
                "message": "src/data is pure: no three.js, React or other layers (see docs/CODE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/scene/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**", "bun:*", "bun"],
                "message": "Keep code runtime-portable: use web APIs or @portable/* (see docs/CODE.md)."
              },
              {
                "group": ["react", "react-dom", "react-dom/*", "**/app/**"],
                "message": "src/scene is framework-free: React stays in src/app (see docs/CODE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**"],
                "message": "Tests may import bun:test only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off",
        "no-restricted-globals": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/data/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "node:*/**"],
                "message": "Tests may import bun:test only."
              },
              {
                "group": [
                  "three",
                  "three/*",
                  "react",
                  "react-dom",
                  "react-dom/*",
                  "**/scene/**",
                  "**/app/**"
                ],
                "message": "src/data is pure: no three.js, React or other layers (see docs/CODE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["vite.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "data/**", "research/**", "tools/**", ".agents/**"]
}
