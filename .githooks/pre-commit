#!/bin/sh
# Back pressure: nothing is committed unless formatting, lint, types and tests pass.
# It checks the staged snapshot, not the working tree: unfinished files you aren't committing
# can't block the commit, and can't hide a broken one.
root=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/leuven-precommit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
ln -s "$root/node_modules" "$snapshot/node_modules"
if output=$(cd "$snapshot" && bun run verify:quick 2>&1); then
  echo "verify:quick ✓ (staged snapshot)"
else
  printf '%s\n' "$output"
  echo "\nCommit blocked: the staged snapshot fails the checks above." >&2
  exit 1
fi
