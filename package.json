{
  "name": "leuven-social",
  "description": "Leuven's historic centre as a tiny isometric pixel-art city in the browser, built from open data.",
  "private": true,
  "license": "MIT",
  "homepage": "https://leuven.exe.xyz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basteau/leuven.social.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "bun run verify:quick && bun run build && bun run budget && bun run smoke",
    "verify:quick": "bun run --parallel --no-exit-on-error format:check lint typecheck test",
    "fix": "bun fmt && oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun check",
    "test": "bun test --coverage",
    "budget": "bun scripts/budget.ts",
    "smoke": "bun scripts/smoke.ts",
    "data:fetch": "bun scripts/fetch.ts",
    "bake": "bun scripts/bake.ts",
    "icons": "bun scripts/icons.ts",
    "deploy": "bun scripts/deploy.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@portable/binary": "^0.1.0",
    "@portable/compress": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@portable/png": "^0.1.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agent-browser": "0.41.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.5"
  }
}
