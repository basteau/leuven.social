# Dependencies and build output
node_modules
dist/
dist-server/

# The local multiplayer database (server/main.ts's DATABASE_PATH default)
.data/

# Local secrets, such as RESEND_API_KEY for the dev server
.env

# Local artefacts: smoke-test and review screenshots, OS and editor noise
.artifacts/
.DS_Store
*.log

# Raw and intermediate geodata (~230 MB): `bun run data` fetches and rebuilds it (docs/DATA.md).
# The app only needs public/data/city.bin, and data/sources.lock.json records the inputs.
data/*
!data/README.md
!data/sources.lock.json

# Third-party research material we have no licence to republish
research/slop-newyork/

# Claude Code worktrees for parallel sessions
.claude/worktrees/
